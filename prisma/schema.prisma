generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  passwordAssigned String
  /// Bump this to invalidate JWTs after password or role changes.
  passwordChangedAt DateTime @default(now())
  role             String
  /// Solo evaluadores/supervisores. Catálogo en src/lib/escuelas.ts
  escuela          String?
  /// ADMIN = creado por administración / CSV; REGISTRO = auto-registro o Google
  origen           String   @default("ADMIN")
  /// RUT normalizado sin puntos ni guión (ej. 123456785). Solo participantes.
  rutPersonal      String?
  direccionPersonal String?
  /// Solo dígitos, móvil chileno (9 cifras).
  telefonoMovil    String?
  contactoWhatsapp Boolean  @default(false)
  /// JSON StoredFile[] — PDFs de formalización empresa (máx. 5).
  documentosFormalizacion String @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  formulariosCreados Formulario[]
  postulaciones      Postulacion[]
  asignaciones       AsignacionEvaluador[]
  convocatoriasPool  ConvocatoriaEvaluador[]
  convocatoriasPoolSupervisor ConvocatoriaSupervisor[]
  asignacionesSupervisor      AsignacionSupervisor[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Singleton de plantilla del correo de recuperación de contraseña (id fijo "default").
model ConfigCorreoRecuperacion {
  id              String   @id @default("default")
  asunto          String
  titulo          String
  cuerpo          String
  textoBoton      String
  pie             String
  colorFondo      String   @default("#f4f6fa")
  colorEncabezado String   @default("#0a2156")
  colorBoton      String   @default("#c8102e")
  colorTexto      String   @default("#12203a")
  /// JSON StoredFile o vacío
  imagen          String   @default("")
  updatedAt       DateTime @updatedAt
}

/// Singleton de ajustes de la app (id fijo "default").
model ConfigApp {
  id                              String   @id @default("default")
  permitirEvaluacionPorPregunta   Boolean  @default(false)
  updatedAt                       DateTime @updatedAt
}

/// Plantilla de texto de un aviso de novedad del caso (colores e imagen se toman de recuperación).
model ConfigCorreoNotificacion {
  id         String   @id
  asunto     String
  titulo     String
  cuerpo     String
  textoBoton String
  pie        String
  updatedAt  DateTime @updatedAt
}

model Formulario {
  id             String   @id @default(cuid())
  titulo         String
  descripcion    String   @default("")
  /// FEEDBACK | CONTENIDO
  tipo           String   @default("FEEDBACK")
  modoEvaluacion String   @default("GENERAL") // POR_PREGUNTA | GENERAL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  creadoPorId    String
  creadoPor      User     @relation(fields: [creadoPorId], references: [id])

  preguntas        Pregunta[]
  piezasContenido  PiezaContenido[]
  convocatorias    Convocatoria[]
}

model Pregunta {
  id             String  @id @default(cuid())
  formularioId   String
  formulario     Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  orden          Int
  enunciado      String
  ayuda          String  @default("")
  obligatoria    Boolean @default(true)
  tipo           String
  opciones       String  @default("[]")
  permiteArchivo   Boolean @default(false)
  permiteImagen    Boolean @default(false)
  permiteVideoLink Boolean @default(false)
  conNotas         Boolean @default(false)
  escalaNotas    String  @default("[]")

  respuestas Respuesta[]
  revisiones RevisionPregunta[]
  supervisiones SupervisionPregunta[]

  @@index([formularioId])
}

model PiezaContenido {
  id           String     @id @default(cuid())
  formularioId String
  formulario   Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  orden        Int
  titulo       String
  descripcion  String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  medios MedioContenido[]
  vistas VistaContenido[]

  @@index([formularioId])
}

model MedioContenido {
  id      String         @id @default(cuid())
  piezaId String
  pieza   PiezaContenido @relation(fields: [piezaId], references: [id], onDelete: Cascade)
  orden   Int
  /// imagen | video | archivo
  clase   String
  /// JSON StoredFile o StoredVideoLink
  payload String         @default("{}")
  createdAt DateTime     @default(now())

  @@index([piezaId])
}

model VistaContenido {
  id            String         @id @default(cuid())
  postulacionId String
  postulacion   Postulacion    @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  piezaId       String
  pieza         PiezaContenido @relation(fields: [piezaId], references: [id], onDelete: Cascade)
  vistaAt       DateTime       @default(now())

  @@unique([postulacionId, piezaId])
  @@index([piezaId])
}

model Convocatoria {
  id                         String    @id @default(cuid())
  titulo                     String
  descripcion                String    @default("")
  /// FEEDBACK | CONTENIDO
  tipo                       String    @default("FEEDBACK")
  formularioId               String
  formulario                 Formulario @relation(fields: [formularioId], references: [id])
  estado                     String    @default("ABIERTA")
  /// Si es false, no aparece en el reel ni admite casos nuevos. Los casos existentes siguen visibles.
  visible                    Boolean   @default(true)
  imagen                     String    @default("")
  fechaInicio                DateTime?
  fechaCierre                DateTime?
  evaluacionesPorPostulacion Int       @default(1)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  postulaciones Postulacion[]
  evaluadores   ConvocatoriaEvaluador[]
  supervisores  ConvocatoriaSupervisor[]

  @@index([estado])
  @@index([formularioId])
}

model ConvocatoriaEvaluador {
  id               String       @id @default(cuid())
  convocatoriaId   String
  convocatoria     Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  evaluadorId      String
  evaluador        User         @relation(fields: [evaluadorId], references: [id])
  maxEvaluaciones  Int          @default(0)
  createdAt        DateTime     @default(now())

  @@unique([convocatoriaId, evaluadorId])
}

model ConvocatoriaSupervisor {
  id               String       @id @default(cuid())
  convocatoriaId   String
  convocatoria     Convocatoria @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade)
  supervisorId     String
  supervisor       User         @relation(fields: [supervisorId], references: [id])
  maxSupervisiones Int          @default(0)
  createdAt        DateTime     @default(now())

  @@unique([convocatoriaId, supervisorId])
}

model Postulacion {
  id             String    @id @default(cuid())
  convocatoriaId String
  convocatoria   Convocatoria @relation(fields: [convocatoriaId], references: [id])
  postulanteId   String
  postulante     User      @relation(fields: [postulanteId], references: [id])
  estado         String    @default("BORRADOR")
  nombreCaso     String    @default("")
  enviadaAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  respuestas      Respuesta[]
  asignaciones    AsignacionEvaluador[]
  supervision     AsignacionSupervisor?
  vistasContenido VistaContenido[]

  @@unique([convocatoriaId, postulanteId])
  @@index([postulanteId])
}

model Respuesta {
  id            String   @id @default(cuid())
  postulacionId String
  postulacion   Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  preguntaId    String
  pregunta      Pregunta    @relation(fields: [preguntaId], references: [id])
  valor         String   @default("")
  archivos      String   @default("[]")
  updatedAt     DateTime @updatedAt

  versiones RespuestaVersion[]

  @@unique([postulacionId, preguntaId])
  @@index([postulacionId])
}

model RespuestaVersion {
  id          String   @id @default(cuid())
  respuestaId String
  respuesta   Respuesta @relation(fields: [respuestaId], references: [id], onDelete: Cascade)
  valor       String
  archivos    String   @default("[]")
  createdAt   DateTime @default(now())

  @@index([respuestaId])
}

model AsignacionEvaluador {
  id            String   @id @default(cuid())
  postulacionId String
  postulacion   Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  evaluadorId   String
  evaluador     User     @relation(fields: [evaluadorId], references: [id])
  orden         Int
  estado        String   @default("PENDIENTE")
  rondaActual   Int      @default(1)
  /// OBSERVACIONES | FINALIZAR | vacío: lo que el evaluador envió al supervisor
  intencionPendiente String?
  cicloSupervision   Int     @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  revisiones              RevisionPregunta[]
  revisionesGenerales     RevisionGeneral[]
  supervisionesPregunta   SupervisionPregunta[]
  supervisionesGenerales  SupervisionGeneral[]

  @@unique([postulacionId, evaluadorId])
  @@index([evaluadorId])
}

model AsignacionSupervisor {
  id            String      @id @default(cuid())
  postulacionId String      @unique
  postulacion   Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  supervisorId  String
  supervisor    User        @relation(fields: [supervisorId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([supervisorId])
}

model RevisionPregunta {
  id           String   @id @default(cuid())
  asignacionId String
  asignacion   AsignacionEvaluador @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  preguntaId   String
  pregunta     Pregunta @relation(fields: [preguntaId], references: [id])
  ronda        Int
  ciclo        Int      @default(1)
  veredicto    String
  comentario   String   @default("")
  nota         Int?
  createdAt    DateTime @default(now())

  @@unique([asignacionId, preguntaId, ronda, ciclo])
}

model RevisionGeneral {
  id           String   @id @default(cuid())
  asignacionId String
  asignacion   AsignacionEvaluador @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  ronda        Int
  ciclo        Int      @default(1)
  veredicto    String
  comentario   String   @default("")
  createdAt    DateTime @default(now())

  @@unique([asignacionId, ronda, ciclo])
}

model SupervisionPregunta {
  id           String   @id @default(cuid())
  asignacionId String
  asignacion   AsignacionEvaluador @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  preguntaId   String
  pregunta     Pregunta @relation(fields: [preguntaId], references: [id])
  ronda        Int
  ciclo        Int
  veredicto    String
  comentario   String   @default("")
  createdAt    DateTime @default(now())

  @@unique([asignacionId, preguntaId, ronda, ciclo])
}

model SupervisionGeneral {
  id           String   @id @default(cuid())
  asignacionId String
  asignacion   AsignacionEvaluador @relation(fields: [asignacionId], references: [id], onDelete: Cascade)
  ronda        Int
  ciclo        Int
  veredicto    String
  comentario   String   @default("")
  createdAt    DateTime @default(now())

  @@unique([asignacionId, ronda, ciclo])
}
